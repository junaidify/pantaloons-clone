# Server Configuration
PORT=3000
NODE_ENV=development

# Auth0 Configuration (for JWT verification)
# Get these from Auth0 Dashboard > Applications > Your App > Settings

# Auth0 Domain (e.g., dev-abc123.us.auth0.com)
AUTH0_DOMAIN=your-auth0-domain.auth0.com

# Auth0 Audience (API identifier)
# This should match the API identifier you created in Auth0
# Go to Auth0 Dashboard > Applications > APIs to find/create
AUTH0_AUDIENCE=

# Razorpay Configuration
# Get these from Razorpay Dashboard (https://dashboard.razorpay.com)
# Go to Settings > API Keys

# Razorpay Key ID (starts with 'rzp_test_' for test mode)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Razorpay Key Secret (keep this secret, never expose to frontend!)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# CORS Configuration
# Allowed origins for CORS (comma-separated for multiple origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Note: Never commit actual secrets to version control!
# Copy this file to .env and add your real values there
