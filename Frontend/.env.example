# Auth0 Configuration
# Get these values from your Auth0 Dashboard (https://manage.auth0.com)
# 1. Create an Application (Single Page Application)
# 2. Copy Domain, Client ID from Settings tab

# Auth0 Domain (e.g., dev-abc123.us.auth0.com)
VITE_AUTH0_DOMAIN=your-auth0-domain.auth0.com

# Auth0 Client ID (e.g., AbCdEfGhIjKlMnOpQrStUvWxYz123456)
VITE_AUTH0_CLIENT_ID=your-auth0-client-id

# Auth0 Audience (API identifier - optional, used for JWT tokens)
# If you created an API in Auth0, paste its identifier here
VITE_AUTH0_AUDIENCE=

# Application URLs
# The URL where your frontend is running
VITE_AUTH0_REDIRECT_URI=http://localhost:5173

# Backend API Base URL
# Change this to your backend URL in production
VITE_API_BASE_URL=http://localhost:3000

# Razorpay Configuration
# Get these from Razorpay Dashboard (https://dashboard.razorpay.com)
# Go to Settings > API Keys to generate keys

# Razorpay Key ID (starts with 'rzp_test_' for test mode or 'rzp_live_' for live)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Note: Never commit actual API keys to version control!
# Copy this file to .env and add your real values there
